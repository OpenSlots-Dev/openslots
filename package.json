{
  "name": "openslots",
  "version": "1.0.0",
  "description": "Find therapists accepting new patients and browse community-reported therapy experiences.",
  "type": "module",
  "main": "backend.js",
  "scripts": {
    "start": "node backend.js",
    "dev": "node --env-file=.env --watch backend.js",
    "seed": "npm run seed:providers && npm run seed:experiences",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed:providers": "node --env-file=.env db/seed/seedProviders.js",
    "seed:experiences": "node --env-file=.env db/seed/seedExperienceReports.js",
    "seed:availability": "node --env-file=.env db/seed/seedAvailabilityReports.js"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenSlots-Dev/openslots.git"
  },
  "author": "Ankita Mandalam and Agilan Balaraman",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/OpenSlots-Dev/openslots/issues"
  },
  "homepage": "https://github.com/OpenSlots-Dev/openslots#readme",
  "dependencies": {
    "express": "^5.3.0",
    "mongodb": "^7.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
